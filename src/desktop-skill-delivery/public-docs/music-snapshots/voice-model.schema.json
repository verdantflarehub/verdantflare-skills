{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "station://contracts/v2/voice-model",
  "title": "VoiceModel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "native_model",
    "files",
    "compatibility",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "voice-model"
    },
    "native_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "model_id"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/file"
      },
      "contains": {
        "type": "object",
        "properties": {
          "purpose": {
            "const": "weights"
          }
        },
        "required": [
          "purpose"
        ]
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "model_format"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "supported_service_versions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "load_requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sample_rate_hz": {
              "type": "integer",
              "minimum": 1
            },
            "channels": {
              "type": "integer",
              "minimum": 1
            },
            "device": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "precision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "capabilities",
        "evidence_paths"
      ],
      "properties": {
        "result": {
          "enum": [
            "passed",
            "partial",
            "failed"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "service_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "review_file_path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!\\.vf(?:/|$))(?!.*[. ](?:/|$))(?!.*\\/$)[^\\u0000-\\u001f\\u007f\\\\<>:\"|?*]+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "purpose",
        "required"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "purpose": {
          "enum": [
            "weights",
            "index",
            "config",
            "vocabulary",
            "documentation",
            "verification-audio"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
